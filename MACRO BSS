local TRACKED_CALLS = {
    ["Troops"] = true,      -- Troop management
    ["Voting"] = true,      -- Voting system
    ["Vote"] = true,        -- Vote confirmation
    ["Skip"] = true,        -- Skip wave
    ["Session"] = true,     -- Session commands
}

local function should_track_call(call_type)
    return TRACKED_CALLS[call_type] ~= nil
end

-- ===== REMOTE FUNCTION HOOKING WITH HOOKMETAMETHOD =====
local function hook_remote_function()
    local OldNamecall
    OldNamecall = hookmetamethod(game, '__namecall', function(...)
        local Self, Args = (...), ({select(2, ...)})
        
        if getnamecallmethod() == "InvokeServer" and Self.name == "RemoteFunction" then
            -- Get the call type (usually Args[1])
            local call_type = Args[1]
            
            if _G.record_strat and should_track_call(call_type) then
                -- Process through handler functions
                process_remote_call(call_type, Args)
                
                -- Also log raw arguments for debugging
                local arg_strings = {}
                for i, arg in ipairs(Args) do
                    arg_strings[i] = serialize_argument(arg)
                end
            end
            
            -- Call the original function
            return OldNamecall(..., unpack(Args))
        end
        
        return OldNamecall(..., unpack(Args))
    end)
end

