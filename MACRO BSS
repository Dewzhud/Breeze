        add_log(string.format("🎯 Set Target: %s -> %s", tower_index, target))
        add_log(string.format("   %s", timer_str))
    end,
    
    Abilities = function(Args)
        if not Args[4] or not Args[4].Troop then
            return
        end
        
        local tower_index = Args[4].Troop.Name or "Unknown"
