-- ===== RESIZING HANDLER =====
local is_resizing = false
local min_width = is_mobile and 200 or 200
local min_height = is_mobile and 200 or 150
local max_width = is_mobile and screen_size.X * 0.98 or screen_size.X
local max_height = is_mobile and screen_size.Y * 0.95 or screen_size.Y

resizer_frame.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        is_resizing = true
    end
end)

user_input_service.InputChanged:Connect(function(input)
    if is_resizing and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
        local mouse_pos = input.Position
        local frame_pos = main_frame.AbsolutePosition
        local new_width = math.max(min_width, math.min(max_width, mouse_pos.X - frame_pos.X))
        local new_height = math.max(min_height, math.min(max_height, mouse_pos.Y - frame_pos.Y))
        main_frame.Size = UDim2.new(0, new_width, 0, new_height)
    end
end)

user_input_service.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        is_resizing = false
    end
end)

-- ===== TRACKED CALL TYPES =====
local TRACKED_CALLS = {
    ["Troops"] = true,      -- Troop management
    ["Voting"] = true,      -- Voting system
    ["Vote"] = true,        -- Vote confirmation
    ["Skip"] = true,        -- Skip wave
    ["Session"] = true,     -- Session commands
}

local function should_track_call(call_type)
    return TRACKED_CALLS[call_type] ~= nil
end

-- ===== REMOTE FUNCTION HOOKING WITH HOOKMETAMETHOD =====
local function hook_remote_function()
    local OldNamecall
    OldNamecall = hookmetamethod(game, '__namecall', function(self, ...)
        local method = getnamecallmethod()
        
        if method == "InvokeServer" and self.name == "RemoteFunction" then
            local Args = {...}
            local call_type = Args[1]
            
            if _G.record_strat and should_track_call(call_type) then
                -- Process through handler functions (non-blocking)
                task.spawn(function()
                    process_remote_call(call_type, Args)
                end)
            end
            
            -- Call the ORIGINAL function properly
            return OldNamecall(self, ...)
        end
        
        return OldNamecall(self, ...)
    end)
end

