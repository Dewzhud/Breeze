local function get_timer()
    local state_folder = replicated_storage:FindFirstChild("State")
    if not state_folder then
        return {0, 0, 0}
    end
    
    local timer_value = state_folder:FindFirstChild("Timer")
    if timer_value and timer_value:FindFirstChild("Time") then
        local time_val = timer_value.Time.Value
        local minutes = math.floor(time_val / 60)
        local seconds = time_val % 60
        return {minutes, seconds, current_wave}
    end
    
    return {0, 0, current_wave}
end

local function get_timer_string()
    local timer_data = get_timer()
    return string.format("[Wave:%d Time:%02d:%02d]", timer_data[3], timer_data[1], timer_data[2])
end

