-- ===== REMOTE FUNCTION HOOKING =====
local hooked_invoke_remotes = {}

local function hook_remote_function(remote)
    if not remote or not remote:IsA("RemoteFunction") then return end
    if hooked_invoke_remotes[remote] then return end
    
    local remote_name = remote.Name
    
    -- Wrap the remote function safely
    pcall(function()
        local original = remote.InvokeServer
        
        remote.InvokeServer = function(self, ...)
            local args = {...}
            local has_voting = check_args_for_voting(...)
            
            if has_voting and _G.record_strat then
                local arg_strings = {}
                for i, arg in ipairs(args) do
                    arg_strings[i] = serialize_argument(arg)
                end
                
                local command = string.format('TDS:RemoteCall("%s", %s)', 
                    remote_name,
                    table.concat(arg_strings, ", ")
                )
                record_action(command)
                add_log(string.format("🗳️ VOTE/SKIP: %s (%d args)", remote_name, #args))
            end
            
            -- Call the original function
            if original then
                return original(self, ...)
            end
            return nil
        end
        
        hooked_invoke_remotes[remote] = true
    end)
end

-- ===== REMOTE EVENT HOOKING (Incoming Data) =====
local function hook_remote_event(remote_event)
    if not remote_event or not remote_event:IsA("RemoteEvent") then return end
    if hooked_remotes[remote_event] then return end
    
    local event_name = remote_event.Name
    
    remote_event.OnClientEvent:Connect(function(...)
        if not _G.record_strat then return end
        
        local args = {...}
        
        -- Log all incoming remote events
        local arg_strings = {}
        for i, arg in ipairs(args) do
            arg_strings[i] = serialize_argument(arg)
        end
        
        local command = string.format('-- Incoming: %s(%s)', 
            event_name,
            table.concat(arg_strings, ", ")
        )
        
        -- Check for wave/round related data
        if event_name:lower():find("wave") or event_name:lower():find("round") or 
           (args[1] and tostring(args[1]):lower():find("wave")) then
            record_action(command)
            add_log(string.format("📊 WAVE EVENT: %s (%d args)", event_name, #args))
        elseif event_name:lower():find("enemy") or event_name:lower():find("spawn") then
            record_action(command)
            add_log(string.format("👾 SPAWN EVENT: %s (%d args)", event_name, #args))
        elseif event_name:lower():find("vote") or event_name:lower():find("skip") then
            record_action(command)
            add_log(string.format("🗳️ VOTE EVENT: %s (%d args)", event_name, #args))
        elseif event_name:lower():find("damage") or event_name:lower():find("health") then
            record_action(command)
            add_log(string.format("❤️ HEALTH EVENT: %s (%d args)", event_name, #args))
        else
            record_action(command)
            add_log(string.format("📡 EVENT: %s (%d args)", event_name, #args))
        end
    end)
    
    hooked_remotes[remote_event] = true
end

local function hook_all_remotes()
    for _, child in ipairs(replicated_storage:GetChildren()) do
        if child:IsA("RemoteFunction") then
            hook_remote_function(child)
        elseif child:IsA("RemoteEvent") then
            hook_remote_event(child)
        elseif child:IsA("Folder") or child:IsA("Model") then
            for _, subchild in ipairs(child:GetChildren()) do
                if subchild:IsA("RemoteFunction") then
                    hook_remote_function(subchild)
                elseif subchild:IsA("RemoteEvent") then
                    hook_remote_event(subchild)
                end
            end
        end
    end
end

replicated_storage.ChildAdded:Connect(function(child)
    if child:IsA("RemoteFunction") then
        hook_remote_function(child)
    elseif child:IsA("RemoteEvent") then
        hook_remote_event(child)
    elseif child:IsA("Folder") or child:IsA("Model") then
        child.ChildAdded:Connect(function(subchild)
            if subchild:IsA("RemoteFunction") then
                hook_remote_function(subchild)
            elseif subchild:IsA("RemoteEvent") then
                hook_remote_event(subchild)
            end
        end)
        for _, subchild in ipairs(child:GetChildren()) do
            if subchild:IsA("RemoteFunction") then
                hook_remote_function(subchild)
            elseif subchild:IsA("RemoteEvent") then
                hook_remote_event(subchild)
            end
        end
    end
end)

hook_all_remotes()

