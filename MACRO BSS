-- ===== WAVE DETECTION =====
local current_wave = 0
local wave_monitor = nil

local function setup_wave_detection()
    local state_folder = replicated_storage:FindFirstChild("State")
    if state_folder then
        local wave_value = state_folder:FindFirstChild("Wave")
        if wave_value and wave_value:IsA("IntValue") then
            current_wave = wave_value.Value
            
            -- Monitor wave changes
            if not wave_monitor then
                wave_monitor = wave_value.Changed:Connect(function(new_wave)
                    current_wave = new_wave
                    if _G.record_strat then
                        local wave_log = string.format("-- WAVE %d STARTED", new_wave)
                        record_action(wave_log)
                        add_log(string.format("📊 WAVE %d STARTED", new_wave))
                    end
                end)
            end
        end
    end
end

setup_wave_detection()

-- ===== HANDLER FUNCTIONS FOR REMOTE CALLS =====
local TowersList = {}
local TowerCount = 0

local function get_timer()
    local state_folder = replicated_storage:FindFirstChild("State")
    if not state_folder then
        return {0, 0, 0}
    end
    
    local timer_value = state_folder:FindFirstChild("Timer")
    if timer_value and timer_value:FindFirstChild("Time") then
        local time_val = timer_value.Time.Value
        local minutes = math.floor(time_val / 60)
        local seconds = time_val % 60
        return {minutes, seconds, current_wave}
    end
    
    return {0, 0, current_wave}
end

local function get_timer_string()
    local timer_data = get_timer()
    return string.format("[Wave:%d Time:%02d:%02d]", timer_data[3], timer_data[1], timer_data[2])
end

local HandlerFunctions = {
    Place = function(Args)
        if not Args[3] or not Args[4] then
            return
        end
        
        local tower_name = Args[3]
        local tower_data = Args[4]
        
        -- Handle Position
        local position
        if tower_data.Position then
            if typeof(tower_data.Position) == "Vector3" then
                position = tower_data.Position
            elseif tower_data.Position.Position then
                position = tower_data.Position.Position
            end
        end
        
        -- Handle Rotation
        local rotation_angles = {0, 0, 0}
        if tower_data.Rotation then
            if typeof(tower_data.Rotation) == "CFrame" then
                local rotate_x, rotate_y, rotate_z = tower_data.Rotation:ToEulerAnglesYXZ()
                rotation_angles = {rotate_x, rotate_y, rotate_z}
            end
        end
        
        if not position then
            add_log(string.format("⚠️ Place failed: Invalid position for %s", tower_name))
            return
        end
        
        TowerCount = TowerCount + 1
        TowersList[TowerCount] = {
            ["TowerName"] = tower_name,
            ["Position"] = position,
            ["Rotation"] = rotation_angles,
            ["Wave"] = current_wave,
        }
        
        local timer_str = get_timer_string()
        local rotation_str = string.format("CFrame.Angles(%.3f, %.3f, %.3f)", rotation_angles[1], rotation_angles[2], rotation_angles[3])
        
        -- Record to file
        local command = string.format('TDS:Place("%s", %.3f, %.3f, %.3f, %s, %s) -- %s', 
            tower_name, 
            position.X, 
            position.Y, 
            position.Z, 
            rotation_str,
            timer_str,
            get_timer_string()
        )
        record_action(command)
        
        -- Log to GUI
        add_log(string.format("📍 Placed: %s", tower_name))
        add_log(string.format("   Position: (%.1f, %.1f, %.1f)", position.X, position.Y, position.Z))
        add_log(string.format("   Rotation: (%.3f, %.3f, %.3f)", rotation_angles[1], rotation_angles[2], rotation_angles[3]))
        add_log(string.format("   %s [Tower Index: %d]", timer_str, TowerCount))
    end,
    
    Upgrade = function(Args)
        if not Args[3] or not Args[4] then
            return
        end
        
        local troop_data = Args[4]
        local tower_index = "Unknown"
        
        if troop_data.Troop and troop_data.Troop.Name then
            tower_index = troop_data.Troop.Name
        elseif type(Args[3]) == "number" then
            tower_index = Args[3]
        end
        
        local path_target = troop_data.Path or "Standard"
        local timer_str = get_timer_string()
        
        local command = string.format('TDS:Upgrade(%s, "%s", %s) -- %s', 
            tower_index, 
            path_target,
            timer_str,
            get_timer_string()
        )
        record_action(command)
        
        add_log(string.format("⬆️ Upgraded Tower: %s", tower_index))
        add_log(string.format("   Path: %s", path_target))
        add_log(string.format("   %s", timer_str))
    end,
    
    Sell = function(Args)
        if not Args[3] or not Args[3].Troop then
            return
        end
        
        local tower_index = Args[3].Troop.Name or "Unknown"
        local timer_str = get_timer_string()
        
        local command = string.format('TDS:Sell(%s, %s) -- %s', 
            tower_index,
            timer_str,
            get_timer_string()
        )
        record_action(command)
        
        add_log(string.format("💰 Sold Tower: %s", tower_index))
        add_log(string.format("   %s", timer_str))
    end,
    
    Target = function(Args)
        if not Args[4] or not Args[4].Troop then
            return
        end
        
        local tower_index = Args[4].Troop.Name or "Unknown"
        local target = Args[4].Target or "Unknown"
