        end
        
        local tower_index = Args[4].Troop.Name or "Unknown"
        local ability_name = Args[4].Name or "Unknown"
        local timer_str = get_timer_string()
        
        local command = string.format('TDS:Ability(%s, "%s", %s) -- %s', 
            tower_index,
            ability_name,
            timer_str,
            get_timer_string()
        )
        record_action(command)
        
        add_log(string.format("✨ Used Ability: %s", ability_name))
        add_log(string.format("   Tower: %s", tower_index))
        add_log(string.format("   %s", timer_str))
    end,
    
    Option = function(Args)
        if not Args[4] or not Args[4].Troop then
            return
        end
        
        local tower_index = Args[4].Troop.Name or "Unknown"
        local option_name = Args[4].Name or "Unknown"
        local value = Args[4].Value or "Unknown"
        local timer_str = get_timer_string()
        
        local command = string.format('TDS:Option(%s, "%s", "%s", %s) -- %s', 
            tower_index,
            option_name,
            value,
            timer_str,
            get_timer_string()
        )
        record_action(command)
        
        add_log(string.format("⚙️ Option: %s = %s", option_name, value))
        add_log(string.format("   Tower: %s", tower_index))
        add_log(string.format("   %s", timer_str))
    end,
    
    Skip = function(Args)
        local timer_str = get_timer_string()
        
        local command = string.format('TDS:Skip(%s) -- %s', 
            timer_str,
            get_timer_string()
        )
        record_action(command)
        
        add_log(string.format("⏭️ Skipped Wave %d", current_wave))
        add_log(string.format("   %s", timer_str))
    end,
    
    Voting = function(Args)
        if not Args[2] then
            return
        end
        
        local vote_type = Args[2]
        local timer_str = get_timer_string()
        
        local command = string.format('TDS:Vote("%s", %s) -- %s', 
            vote_type,
            timer_str,
            get_timer_string()
        )
        record_action(command)
        
        add_log(string.format("🗳️ Voted: %s", vote_type))
        add_log(string.format("   %s", timer_str))
    end,
}

local function process_remote_call(call_type, Args)
    if HandlerFunctions[call_type] then
        pcall(HandlerFunctions[call_type], Args)
    end
end

