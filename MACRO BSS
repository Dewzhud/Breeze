-- ===== REMOTE FUNCTION HOOKING WITH HOOKMETAMETHOD =====
local function hook_remote_function()
    local OldNamecall
    OldNamecall = hookmetamethod(game, '__namecall', function(self, ...)
        local method = getnamecallmethod()
        
        if method == "InvokeServer" and self.name == "RemoteFunction" then
            local Args = {...}
            local call_type = Args[1]
            
            if _G.record_strat and should_track_call(call_type) then
                -- Process through handler functions (non-blocking)
                task.spawn(function()
                    process_remote_call(call_type, Args)
                end)
            end
            
            -- Call the ORIGINAL function properly
            return OldNamecall(self, ...)
        end
        
        return OldNamecall(self, ...)
    end)
end

